{
  "name": "aizen-skill-eval",
  "version": "3.0.0",
  "description": "Evaluate a skill against a baseline: trigger tests, with/without runs, grader, A/B comparator and benchmark aggregation",
  "framework": "Aizen",
  "kind": "entry",
  "topics": [
    "eval"
  ],
  "requires": [
    "aizen-core"
  ],
  "contract": {
    "outputs": [
      ".aizen/cache/eval/*/iteration-*/review.md"
    ],
    "steps": [
      {
        "id": "criteria",
        "evidence": [
          "file"
        ],
        "hint": "success criteria confirmed with the owner"
      },
      {
        "id": "eval-set",
        "evidence": [
          "file"
        ],
        "hint": "skills/<name>/evals/evals.json with a negative control"
      },
      {
        "id": "runs",
        "evidence": [
          "file"
        ],
        "hint": "with_skill and baseline run folders"
      },
      {
        "id": "grade",
        "evidence": [
          "file"
        ],
        "hint": "grading.json per run, by independent graders"
      },
      {
        "id": "aggregate",
        "evidence": [
          "cmd"
        ],
        "hint": "aggregate_benchmark.py"
      }
    ],
    "rules": [],
    "verifier": {
      "required": false
    }
  }
}
