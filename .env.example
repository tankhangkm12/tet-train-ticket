# Server port for the Spring Boot application (8080 for api, 8081 for wr, 8082 for worker)
SERVER_PORT=8080

# Active Spring profile (api, wr, or worker)
SPRING_PROFILES_ACTIVE=api

# PostgreSQL database host
POSTGRES_HOST=localhost

# PostgreSQL database port
POSTGRES_PORT=5432

# PostgreSQL database name
POSTGRES_DB=tet_ticket

# PostgreSQL database user
POSTGRES_USER=postgres

# PostgreSQL database password
POSTGRES_PASSWORD=postgrespassword

# Redis cache and queue host
REDIS_HOST=localhost

# Redis cache and queue port
REDIS_PORT=6379

# Apache Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# SMTP host for email delivery (defaults to localhost for local Mailpit)
MAIL_HOST=localhost

# SMTP port
MAIL_PORT=1025

# Ed25519 JWT Public Key (Base64 encoded) for token verification in all modules
JWT_PUBLIC_KEY=MCowBQYDK2VwAyEAVmTvQ8njvYoQ1WBKOvbcsrqi9Nvaery5qD2LHTyII+0=

# Ed25519 JWT Private Key (Base64 encoded) used exclusively by identity module
JWT_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEICyou5y8vnEP0V3Kl61JGlfmho3Hhd6pCWNsqF318zTP

# Virtual waiting room admission rate limit (tickets admitted per second)
APP_QUEUE_ADMIT_RATE=100
