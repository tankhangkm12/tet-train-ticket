{
  "name": "aizen-skill-importer",
  "version": "4.0.0",
  "description": "Import a skill or upstream knowledge from GitHub or a local folder into Aizen, with source, licence and pinned commit, customize it and prove it in an A/B test",
  "framework": "Aizen",
  "kind": "entry",
  "requires": [
    "aizen-core",
    "aizen-skill-creator",
    "aizen-skill-eval"
  ],
  "contract": {
    "outputs": [
      "skills/{run}/SKILL.md"
    ],
    "steps": [
      {
        "id": "fetch",
        "evidence": [
          "cmd"
        ],
        "hint": "fetch_skill.py, baseline kept in .aizen/cache/import/<name>/"
      },
      {
        "id": "change-summary",
        "evidence": [
          "file"
        ],
        "hint": "the confirmed change list, saved under the run's work/ folder"
      },
      {
        "id": "ab-test",
        "evidence": [
          "file"
        ],
        "hint": "comparator verdict from aizen-skill-eval"
      },
      {
        "id": "tests",
        "evidence": [
          "cmd",
          "out"
        ],
        "hint": "npm test, green"
      },
      {
        "id": "commit",
        "evidence": [
          "sha"
        ]
      }
    ],
    "rules": [
      {
        "id": "repo-tests",
        "type": "command",
        "run": "node tests/check-skills.js"
      },
      {
        "id": "licence",
        "type": "command",
        "run": "ls \"{output_dir}\" | grep -qi -E 'licen[cs]e|UPSTREAM'"
      }
    ],
    "expectations": [
      {
        "id": "E1",
        "text": "Every change on the agreed change list is in the skill; nothing else changed"
      },
      {
        "id": "E2",
        "text": "The upstream licence and credit are kept"
      },
      {
        "id": "E3",
        "text": "The A/B result shows the customised skill is not worse than the original on the sample task"
      }
    ],
    "verifier": {
      "required": true
    }
  }
}
